# Mailbox that sends and receives (use your own business mailbox, e.g. Google Workspace / Zoho; app password).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=
IMAP_HOST=imap.example.com
IMAP_PORT=993

# Email confirmation before sending (use one). Without a key only free local checks run and
# most first messages are held, because an address is only sent to once confirmed valid.
ZEROBOUNCE_API_KEY=
HUNTER_API_KEY=
# VERIFY_PROVIDER=zerobounce   # or hunter, or local

# Optional: lets the proposal step read the company's public YouTube videos (YouTube Data API v3 key).
YOUTUBE_API_KEY=
# n8n (or Make/Zapier): important events are pushed here. Use https, or http only on your own machine.
# WEBHOOK_SECRET must match the secret you set in n8n's Header Auth credential.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Lets n8n ask for a search or block a person (POST /api/hooks/...). Never lets it approve or send anything.
HOOK_TOKEN=

# Optional: fixed dashboard token (otherwise a new one is printed each time).
DASHBOARD_TOKEN=

# Reads and answers replies (Claude). LLM_MODEL is optional; default claude-opus-5-5.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# Copy to .env (git-ignored) and fill in. Needed only for --provider google.
# Enable "Places API (New)" in Google Cloud and create an API key restricted to it.
GOOGLE_PLACES_API_KEY=
